{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowedActionsOfAll",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "ec2:*",
        "iam:*",
        "ecs:*",
        "ecr:*",
        "bedrock:*",
        "secretsmanager:*",
        "cloudwatch:*",
        "logs:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-east-2",
            "us-west-2"
          ]
        }
      }
    }
  ]
}