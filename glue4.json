{
  "Version": "2012-10-17",
  "Statement": [
      {
          "Effect": "Allow",
          "Action": [
              "glue:GetDatabase",
              "glue:GetDatabases",
              "glue:GetTable",
              "glue:GetTables",
              "glue:GetTableVersions",
              "glue:GetCrawler",
              "glue:GetCrawlers",
              "glue:GetCrawlerMetrics",
              "glue:GetJob",
              "glue:GetJobs",
              "glue:GetTriggers",
              "glue:SearchTables",
              "glue:CreateDatabase",
              "glue:CreateTable",
              "glue:CreateTrigger",
              "glue:CreateJob",
              "glue:CreateCrawler",
              "glue:StartCrawler",
              "glue:StartJobRun",
              "glue:StartTrigger",
              "glue:BatchCreatePartition",
              "glue:UpdateDatabase",
              "glue:UpdateTable",
              "glue:UpdateTrigger",
              "glue:UpdateJob",
              "glue:UpdateCrawler",
              "glue:DeleteDatabase",
              "glue:DeleteTable",
              "glue:DeleteTrigger",
              "glue:DeleteJob",
              "glue:DeleteCrawler",
              "glue:BatchDeletePartition",
              "glue:GetPartition",
              "glue:GetPartitions",
              "glue:CreatePartition",
              "glue:DeletePartition",
              "glue:CreateScript",
              "iam:CreateRole",
              "iam:AttachRolePolicy",
              "iam:PutRolePolicy",
              "iam:PassRole",
              "iam:ListRoles",
              "logs:CreateLogGroup",
              "logs:CreateLogStream",
              "logs:PutLogEvents",
              "iam:GetRole",
              "s3:*",
              "lakeformation:*",
              "iam:ListPolicies",
              "iam:ListRolePolicies",
              "iam:CreateServiceLinkedRole",
              "iam:ListAttachedRolePolicies",
              "iam:GetAccountSummary",
              "iam:ListRoleTags",
              "iam:GetPolicyVersion",
              "iam:ListUsers",
              "iam:GetUser",
              "glue:ListCrawls",
              "glue:GetTableVersion",
              "glue:ListCrawlers",
              "glue:BatchGetCrawlers",
              "glue:CreateClassifier",
              "glue:CreateSession",
              "glue:DeleteClassifier",
              "glue:DeleteSession",
              "logs:GetLogEvents",
              "cloudwatch:GetMetricData",
              "glue:Get*",
              "glue:List*",
              "glue:CreateConnection",
              "glue:DeleteConnection",
              "glue:TagResource",
              "logs:FilterLogEvents",
              "logs:DescribeLogGroups",
              "glue:GetJobRun",
              "glue:GetJobRuns",
              "glue:BatchGetJobs",
              "glue:StopSession"
          ],
          "Resource": "*",
          "Condition": {
              "StringEquals": {
                  "aws:RequestedRegion": [
                      "us-east-1",
                      "us-east-2",
                      "us-west-2"
                  ]
              }
          }
      },
      {
          "Effect": "Deny",
          "Action": [
              "s3:PutBucketPolicy",
              "s3:DeleteBucketPolicy",
              "s3:PutObjectRetention"
          ],
          "Resource": "*"
      }
  ]
}