{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "DID": {
      "type": "string"
    },
    "trainerUserName": {
      "type": "string"
    },
    "trainerUserPassword": {
      "type": "string"
    },
    "imgid": {
      "type": "string"
    },
    "disksize": {
      "type": "string"
    },
    "vmAdminUsername": {
      "type": "string",
      "defaultValue": "Labuser"
    },
    "vmAdminPassword": {
      "type": "string",
      "defaultValue": "Password.1!!"
    },
    "ODLID": {
      "type": "string"
    },
    "InstallCloudLabsShadow": {
      "type": "string"
    },
    "DeploymentID": {
            "type": "string"
    },
    "userEmail": {
            "type": "string"
    }
  },
  "variables": {
    "virtualNetworkName": "arrow-azure-site-vnet",
    "virtualMachineName": "Labvm-Host",
    "Enable-CloudLabsEmbeddedShadow": "[concat(' -vmAdminUsername ', parameters('vmAdminUsername'), ' -vmAdminPassword ', parameters('vmAdminPassword'), ' -trainerUserName ', parameters('trainerUserName'), ' -trainerUserPassword ', parameters('trainerUserPassword'), ' -userEmail ', parameters('userEmail'), ' -DeploymentID ', parameters('DeploymentID'))]",
    "virtualMachineSize": "Standard_D8s_v3",
    "networkInterfaceName": "[concat(variables('virtualMachineName'), '-nic')]",
    "networkInterface2Name": "[concat(variables('virtualMachineName'), '-nic2')]",
    "networkSecurityGroupName": "[concat(variables('virtualMachineName'), '-nsg')]",
    "publicIpAddressName": "[concat(variables('virtualMachineName'), '-pip')]",
    "publicIpAddressDNSName": "[concat('labvm-host-', parameters('DID'))]",
    "subnetName": "vm-subnet",
    "location": "[resourceGroup().location]",
    "subnetRef": "/subscriptions/2b39737e-1727-4625-93f2-d5d6739f9a85/resourceGroups/arrow-s2s-vpn/providers/Microsoft.Network/virtualNetworks/arrow-azure-site-vnet/subnets/vm-subnet",
    "osdiskname": "Labvm-OSDisk"
  },
  "resources": [
    {
      "apiVersion": "2016-09-01",
      "name": "pid-e843308b-3ce2-42a2-b743-2f21b36a5e68",
      "type": "Microsoft.Resources/deployments",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      }
    },
    {
      "type": "Microsoft.Compute/disks",
      "apiVersion": "2022-07-02",
      "name": "Labvm-OSDisk",
      "location": "[variables('location')]",
      "sku": {
        "name": "Premium_LRS",
        "tier": "Premium"
      },
      "properties": {
        "osType": "Windows",
        "hyperVGeneration": "V2",
        "supportedCapabilities": {
          "architecture": "x64",
					"acceleratedNetwork": true
        },
        "creationData": {
          "createOption": "FromImage",
          "imageReference": {
            "id": "[parameters('imgid')]"
          },
          "galleryImageReference": {
            "id": "[parameters('imgid')]"
          }
        },
        "diskSizeGB": "[parameters('disksize')]",
        "diskIOPSReadWrite": 1100,
        "diskMBpsReadWrite": 125,
        "encryption": {
          "type": "EncryptionAtRestWithPlatformKey"
        },
        "networkAccessPolicy": "AllowAll",
        "publicNetworkAccess": "Enabled",
        "diskState": "Reserved",
        "tier": "P15"
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('networkSecurityGroupName')]",
      "apiVersion": "2017-06-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-rdp",
            "properties": {
              "priority": 1000,
              "protocol": "TCP",
              "access": "Allow",
              "direction": "Inbound",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[variables('publicIpAddressName')]",
      "apiVersion": "2018-01-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "publicIPAllocationMethod": "Dynamic",
        "dnsSettings": {
          "domainNameLabel": "[concat(variables('publicIpAddressDNSName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('networkInterfaceName')]",
      "apiVersion": "2016-09-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "ipConfigurations": [
          {
            "name": "Labvm-VM-PIP",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "publicIPAddress": {
                "id": "[resourceId(resourceGroup().name,'Microsoft.Network/publicIpAddresses', variables('publicIpAddressName'))]"
              }
            }
          }
        ],
        "enableAcceleratedNetworking": true,
        "networkSecurityGroup": {
          "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]"
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpAddressName'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('networkInterface2Name')]",
      "apiVersion": "2016-09-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "ipConfigurations": [
          {
            "name": "Labvm-VM-PIP2",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('subnetRef')]"
              }
            }
          }
        ],
        "enableAcceleratedNetworking": true,
        "networkSecurityGroup": {
          "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]"
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('virtualMachineName')]",
      "apiVersion": "2018-06-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "hardwareProfile": {
          "vmSize": "[variables('virtualMachineSize')]"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))]",
              "properties": {
                "primary": true,
                "deleteOption": "Detach"
              }
            },
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterface2Name'))]",
              "properties": {
                "primary": false
              }
            }
          ]
        },
        "storageProfile": {
          "osDisk": {
            "createOption": "Attach",
            "osType": "Windows",
            "managedDisk": {
              "id": "[concat('/subscriptions/', subscription().subscriptionId,'/resourceGroups/',resourceGroup().Name,'/providers/Microsoft.Compute/disks/Labvm-OSDisk')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/disks/', variables('osdiskname'))]",
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName'))]",
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterface2Name'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2015-06-15",
      "name": "[concat(variables('virtualMachineName'),'/', 'winExtension')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[concat('Microsoft.Compute/virtualMachines/', variables('virtualMachineName'))]"
      ],
      "tags": {
        "displayName": "VM Extension"
      },
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.8",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "https://experienceazure.blob.core.windows.net/templates/cloudlabs-common/cloudlabs-windows-functions.ps1",
            "https://cloudlabs-prod-templates-s3.s3.us-east-1.amazonaws.com/arrow/arrowps.ps1"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('powershell.exe -ExecutionPolicy Unrestricted -File arrowps.ps1', variables('Enable-CloudLabsEmbeddedShadow'))]"
        }
      }
    }
  ],
  "outputs": {
    "Labvm Host DNS Name": {
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses',variables('publicIpAddressName'))).dnsSettings.fqdn]",
      "type": "string"
    },
    "Labvm Host admin Username": {
      "type": "string",
      "value": "Labuser"
    },
    "Labvm Host admin Password": {
      "type": "string",
      "value": "Password.1!!"
    },
    "Trainer UserName": {
      "type": "string",
      "value": "[parameters('trainerUserName')]"
    },
    "Trainer Password": {
      "type": "string",
      "value": "[parameters('trainerUserPassword')]"
    }
  }
}